<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/google_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/route_map_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="16dp"
        android:text="@string/route_map_waiting"
        android:textColor="@android:color/black"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="64dp"
        android:elevation="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <Button
            android:id="@+id/route_map_recenter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/map_control_background"
            android:backgroundTint="@null"
            android:contentDescription="@string/route_map_recenter"
            android:minWidth="48dp"
            android:text="@string/route_map_recenter"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/route_map_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/map_control_background"
            android:backgroundTint="@null"
            android:contentDescription="@string/route_map_zoom_in"
            android:text="+"
            android:textColor="@android:color/black"
            android:textSize="24sp" />

        <Button
            android:id="@+id/route_map_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/map_control_background"
            android:backgroundTint="@null"
            android:contentDescription="@string/route_map_zoom_out"
            android:text="−"
            android:textColor="@android:color/black"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
